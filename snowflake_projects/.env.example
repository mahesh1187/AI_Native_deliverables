# Snowflake Connection Configuration
# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control

SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_DATABASE=your_database
SNOWFLAKE_SCHEMA=your_schema
SNOWFLAKE_ROLE=your_role

# ─── SCIM Integration ─────────────────────────────────────────
SCIM_INTEGRATION_NAME=AAD_SCIM_INTEGRATION

# ─── Email Notifications (for SCIM token monitor) ─────────────
# For Gmail: enable 2FA → create App Password → use as EMAIL_PASSWORD
# https://myaccount.google.com/apppasswords
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_RECIPIENTS=admin@example.com,backup_admin@example.com

# ─── Monitor Settings ─────────────────────────────────────────
TOKEN_LIFESPAN_DAYS=180
CHECK_INTERVAL_HOURS=24
